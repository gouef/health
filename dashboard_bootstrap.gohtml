<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-body-tertiary">
  <div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <div>
        <h1 class="h3 mb-1">{{ .Title }}</h1>
        <div class="text-body-secondary small">Generated: {{ .Generated }}</div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button id="theme-toggle" type="button" class="btn btn-outline-secondary btn-sm">Toggle theme</button>
        <div class="badge fs-6 text-bg-{{ statusClass .Status }}">{{ .Status }}</div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Registered Websites</span>
        <span class="badge text-bg-secondary">{{ .TotalCount }}</span>
      </div>
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">URL</th>
              <th scope="col">Status</th>
              <th scope="col">Type</th>
              <th scope="col">Response (ms)</th>
              <th scope="col">Error</th>
            </tr>
          </thead>
          <tbody>
            {{- if .Websites }}
              {{- range .Websites }}
            <tr>
              <td>{{ .Name }}</td>
              <td><a href="{{ .URL }}" target="_blank" rel="noopener noreferrer">{{ .URL }}</a></td>
              <td><span class="badge text-bg-{{ statusClass .Result.Status }}">{{ .Result.Status }}</span></td>
              <td>{{ .Result.Type }}</td>
              <td>{{ .Result.ResponseTime }}</td>
              <td>{{ .Result.Error }}</td>
            </tr>
              {{- end }}
            {{- else }}
            <tr>
              <td colspan="6" class="text-center text-body-secondary py-4">No websites registered.</td>
            </tr>
            {{- end }}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script>
    (function () {
      var storageKey = "health-dashboard-theme";
      var root = document.documentElement;
      var button = document.getElementById("theme-toggle");

      if (!button) {
        return;
      }

      function applyTheme(theme) {
        root.setAttribute("data-bs-theme", theme);
        button.textContent = theme === "dark" ? "Switch to light" : "Switch to dark";
      }

      var savedTheme = localStorage.getItem(storageKey);
      if (savedTheme === "light" || savedTheme === "dark") {
        applyTheme(savedTheme);
      } else {
        applyTheme("dark");
      }

      button.addEventListener("click", function () {
        var nextTheme = root.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
        applyTheme(nextTheme);
        localStorage.setItem(storageKey, nextTheme);
      });
    })();
  </script>
</body>
</html>
